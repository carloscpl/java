<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:jsp="http://java.sun.com/xml/ns/javaee/jsp" xmlns:web="http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd" id="WebApp_ID" version="3.0">
  <display-name>Sistemabancario</display-name>
  <context-param>
    <param-name>javax.servlet.jsp.jstl.fmt.localizationContext</param-name>
    <param-value>messages</param-value>
  </context-param>
  <welcome-file-list>
    <welcome-file>login.jsp</welcome-file>
    <welcome-file>index.html</welcome-file>
    <welcome-file>menu.jsp</welcome-file>
  </welcome-file-list>
  <servlet>
    <description></description>
    <display-name>Bancocrud</display-name>
    <servlet-name>Bancocrud</servlet-name>
    <servlet-class>br.ucb.CRUD.Bancocrud</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Bancocrud</servlet-name>
    <url-pattern>/bancocrud</url-pattern>
  </servlet-mapping>
  <servlet>
    <description></description>
    <display-name>Agenciacrud</display-name>
    <servlet-name>Agenciacrud</servlet-name>
    <servlet-class>br.ucb.CRUD.Agenciacrud</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Agenciacrud</servlet-name>
    <url-pattern>/agenciacrud</url-pattern>
  </servlet-mapping>
  <servlet>
    <description></description>
    <display-name>Clientecrud</display-name>
    <servlet-name>Clientecrud</servlet-name>
    <servlet-class>br.ucb.CRUD.Clientecrud</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Clientecrud</servlet-name>
    <url-pattern>/clientecrud</url-pattern>
  </servlet-mapping>
  <servlet>
    <description></description>
    <display-name>UsuarioCRUD</display-name>
    <servlet-name>UsuarioCRUD</servlet-name>
    <servlet-class>br.ucb.CRUD.UsuarioCRUD</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>UsuarioCRUD</servlet-name>
    <url-pattern>/usuariocrud</url-pattern>
  </servlet-mapping>
  <servlet>
    <description></description>
    <display-name>Contacrud</display-name>
    <servlet-name>Contacrud</servlet-name>
    <servlet-class>br.ucb.CRUD.Contacrud</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Contacrud</servlet-name>
    <url-pattern>/contacrud</url-pattern>
  </servlet-mapping>
  <servlet>
    <description></description>
    <display-name>Login</display-name>
    <servlet-name>Login</servlet-name>
    <servlet-class>br.ucb.CRUD.Login</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Login</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>
  <jsp-config>
    <taglib>
      <taglib-uri>http://java.sun.com/jstl/core</taglib-uri>
      <taglib-location>/WEB-INF/tld/c.tld</taglib-location>
    </taglib>
    <taglib>
      <taglib-uri>http://java.sun.com/jstl/fmt</taglib-uri>
      <taglib-location>/WEB-INF/tld/fmt.tld</taglib-location>
    </taglib>
  </jsp-config>
</web-app>